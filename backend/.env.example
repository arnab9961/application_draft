# Application environment
APP_ENV=production
APP_SECRET_KEY=change-this-to-a-strong-random-secret-key

# Allowed authorized user email (your email only)
AUTHORIZED_USER_EMAIL=you@example.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google OAuth / Gmail API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/api/gmail/callback

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=https://your-app.vercel.app

# CORS origins (comma-separated)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
